{
  "name": "gtodo",
  "productName": "GTodo",
  "version": "0.1.0",
  "private": true,
  "description": "支持番茄钟、桌面便签、日历同步与自适应缩放的桌面待办应用",
  "author": "GTodo",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:outlook": "tsx scripts/test-outlook-native.ts",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.gtodo.desktop",
    "productName": "GTodo",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json"
    ],
    "extraResources": [{ "from": "dist-electron/outlook-bridge.ps1", "to": "outlook-bridge.ps1" }],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "GTodo-v${version}-Windows-x64.exe"
    }
  }
}
