{
  "name": "gtodo",
  "productName": "GTodo",
  "version": "0.1.2",
  "private": true,
  "description": "支持番茄钟、桌面便签、日历同步与自适应缩放的桌面待办应用",
  "author": "GTodo",
  "license": "MIT",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "test": "tsx --test tests/*.test.ts",
    "test:notes": "node scripts/test-notes-native.mjs",
    "test:capture": "node scripts/test-screen-capture-native.mjs",
    "test:pomodoro-layout": "node scripts/test-pomodoro-layout.mjs",
    "test:taskbar": "node scripts/test-taskbar-native.mjs",
    "test:outlook": "tsx scripts/test-outlook-native.ts",
    "bench:startup": "node scripts/benchmark-startup.mjs",
    "pack": "npm run build && electron-builder --win --dir",
    "dist": "npm run build && electron-builder --win zip portable --x64"
  },
  "dependencies": {
    "lucide-react": "^1.75.0",
    "mdast-util-from-markdown": "^2.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.27.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "build": {
    "appId": "app.gtodo.desktop",
    "productName": "GTodo",
    "asar": true,
    "artifactName": "GTodo-v${version}-Windows-${arch}.${ext}",
    "electronLanguages": ["zh-CN", "zh-TW", "en-US"],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/icon.png",
      "assets/icon.ico",
      "package.json",
      "!node_modules/**/*",
      "!dist-electron/**/*.map"
    ],
    "extraResources": [
      {
        "from": "dist-electron/outlook-bridge.ps1",
        "to": "outlook-bridge.ps1"
      }
    ],
    "win": {
      "target": [
        "zip",
        "portable"
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "portable": {
      "artifactName": "GTodo-v${version}-Windows-x64.exe",
      "unpackDirName": true
    }
  }
}
